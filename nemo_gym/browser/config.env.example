# Copy to config.env next to the submit script. Never commit real values.

VERL_ROOT=/path/to/verl
NEMO_GYM_ROOT=/path/to/Gym
HF_HOME=/path/to/hf_home
RESULTS_ROOT=/path/to/results
WANDB_API_KEY=
WANDB_USERNAME=

# Resources server started by the submit script, and the URL the tool talks to.
# Use `interactive_browser` for a local Chromium, or `interactive_browser/lexmount`
# to drive remote browsers through a session provider.
BROWSER_RESOURCES_SERVER=interactive_browser
NEMO_GYM_BROWSER_URL=http://127.0.0.1:8000

# Judge for open-ended tasks (any OpenAI-compatible endpoint). Tasks that ship a
# deterministic `verifier_metadata` are scored by the environment instead and do
# not need these.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Only for BROWSER_RESOURCES_SERVER=interactive_browser/lexmount.
LEXMOUNT_BASE_URL=
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
