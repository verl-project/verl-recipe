+        error_msg = (
+            f"验证失败，输出不一致(误差数/最大容忍误差数): "
+            f"err_cnt={err_cnt} / {limit_cnt}, dtype={data_type}, limit={limit}\n"
+        )
+        error_msg += f"最大相对误差: {max_error:.6e}, 平均相对误差: {mean_error:.6e}\n"
+        error_msg += f"前 {num_to_show} 个不一致的值:\n"
