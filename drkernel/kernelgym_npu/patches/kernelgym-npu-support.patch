 from kernelgym.common import ErrorCode
 
+# Device-fatal error signatures. When any of these appears in an error string, the
+# GPU/NPU device context is corrupted and the worker subprocess holding that device
+# must be recycled. If it is not, every subsequent task on that worker keeps failing
+# until the routine max-tasks restart — observed on Ascend as a long run of false
+# "compilation failed" results triggered by a single out-of-bounds kernel.
+DEVICE_FATAL_ERROR_SIGNATURES = (
+    # NVIDIA / CUDA
+    "illegal memory access",
+    "device-side assert",
+    "misaligned address",
+    "unspecified launch failure",
+    "cuda_error_illegal_address",
+    # Huawei Ascend NPU vector-core / MTE faults (surface as error code 507035)
+    "507035",
+    "vector core execution is abnormal",
+    "the ddr address of the mte instruction is out of range",
+    "aclrtsynchronizedevicewithtimeout",
+    "rtdevicesynchronizewithtimeout",
+    "aivec error",
+)
+
+
+def is_device_fatal_error(error_message: Optional[str]) -> bool:
+    """Return True if the text contains a signature of a device-corrupting fault.
+
+    Such faults (e.g. an out-of-bounds kernel triggering the Ascend vector-core
+    exception 507035) poison the device context, so the worker holding that device
+    must be recycled rather than kept in service.
+    """
+    if not error_message:
+        return False
+    text = error_message.lower()
+    return any(sig in text for sig in DEVICE_FATAL_ERROR_SIGNATURES)
+
 
 def classify_error(error_message: str, context: Optional[str] = None) -> ErrorCode:
     """Classify error message into appropriate error code."""
